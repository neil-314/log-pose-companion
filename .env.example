# Server-only configuration. Copy to .env.local for local development.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Enable only after OTP templates and email delivery have been configured.
SUPABASE_EMAIL_READY=false

# Harbour server runtime; never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-server-only-secret-key
HARBOUR_ENABLED=false
HARBOUR_MODERATOR_EMAILS=your-verified-moderator-email
# Optional comma-separated verified account IDs for staging tests.
HARBOUR_MODERATOR_IDS=
